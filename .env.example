# ============================================================
# EzeFloor environment configuration
# Copy this file to .env and change deployment values only.
# ============================================================

# ------------------------------------------------------------
# 1. Application / Network / Proxy
# ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8090
FRONTEND_PUBLIC_URL=http://localhost:3011
BACKEND_URL=http://127.0.0.1:8090
NEXT_PUBLIC_API_BASE_URL=
MAX_UPLOAD_SIZE=52428800
CORS_ORIGINS=http://localhost:3011,http://127.0.0.1:3011
CORS_ORIGIN_REGEX=
NEXT_ALLOWED_DEV_ORIGINS=localhost:3011,127.0.0.1:3011
NEXT_PROXY_TIMEOUT_MS=900000
NEXT_PROXY_MAX_BODY_SIZE=150mb

# ------------------------------------------------------------
# 2. TaskList Integration
# One base URL only; paths/methods define the API contract.
# ------------------------------------------------------------
TASKLIST_API_URL=
TASKLIST_AUTH_PATH=/api/auth/me
TASKLIST_WORKFLOW_PATH=/api/workflow
TASKLIST_AUTH_METHOD=GET
TASKLIST_WORKFLOW_READ_METHOD=GET
TASKLIST_WORKFLOW_WRITE_METHOD=PUT
TASKLIST_WORKFLOW_API_TOKEN=
TASKLIST_API_TIMEOUT_SEC=5
TASKLIST_AUTH_TIMEOUT_SEC=1.5
TASKLIST_VERIFY_SSL=false
TASKLIST_ALLOWED_ORIGINS=http://localhost:3011,http://127.0.0.1:3011

# ------------------------------------------------------------
# 3. Procurement Integration
# ------------------------------------------------------------
PROCUREMENT_WEB_URL=
PROCUREMENT_RECEIVE_JOB_URL=
PROCUREMENT_RECEIVE_JOB_METHOD=POST
PROCUREMENT_API_TIMEOUT_SEC=5
PROCUREMENT_DEFAULT_EMPLOYEE_ID=
SSO_DEFAULT_EMPLOYEE_ID=
DEFAULT_OFFICE_CODE=

# ------------------------------------------------------------
# 4. Local Application Database
# ------------------------------------------------------------
DB_TYPE=sqlite
SQLITE_PATH=storage/ezefloor.db

# MySQL - only required when DB_TYPE=mysql
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# ------------------------------------------------------------
# 5. MSSQL / ProcurementApp
# ------------------------------------------------------------
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DB=emsflow
PROCUREMENT_DB=ProcurementApp
MSSQL_LOGIN_TIMEOUT_SEC=10
MSSQL_QUERY_TIMEOUT_SEC=30

# ------------------------------------------------------------
# 6. OpenAI / EzeIn
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SEC=180
OPENAI_MAX_RETRIES=3
OPENAI_REASONING_EFFORT=none

# ------------------------------------------------------------
# 7. Gemini - Optional / Legacy
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# ------------------------------------------------------------
# 8. SMTP / Notifications
# ------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=EzeFloor AI Support
ADMIN_NOTIFICATION_EMAIL=

# ------------------------------------------------------------
# 9. Security / Session / SSO
# ------------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_MAX_AGE=1800
PASSWORD_SALT=
MAX_FAILED_ATTEMPTS=5
TOOL_AI_SSO_SECRET=

# ------------------------------------------------------------
# 10. OCR / ML Runtime
# ------------------------------------------------------------
FLAGS_ENABLE_PIR_API=0
FLAGS_ENABLE_PIR_IN_EXECUTOR=0
FLAGS_PIR_APPLY_INPLACE_PASS=0
FLAGS_USE_MKLDNN=0
KMP_DUPLICATE_LIB_OK=TRUE
