# EzeFloor deployment configuration
# Copy to .env on a server. Change deployment/integration values here only.

# Application
APP_HOST=0.0.0.0
APP_PORT=8090
APP_PUBLIC_URL=http://localhost:8090
FRONTEND_PUBLIC_URL=http://localhost:3011
BACKEND_URL=http://127.0.0.1:8090
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DIRECT_BACKEND_URL=http://127.0.0.1:8090
MAX_UPLOAD_SIZE=52428800
CORS_ORIGINS=http://localhost:3011,http://127.0.0.1:3011
CORS_ORIGIN_REGEX=https://.*\.ngrok-free\.dev
NEXT_ALLOWED_DEV_ORIGINS=localhost:3011,127.0.0.1:3011,14.241.197.188,*.ngrok-free.dev,*.ngrok-free.app,*.ngrok.io,*.ngrok.app
NEXT_PROXY_TIMEOUT_MS=900000
NEXT_PROXY_MAX_BODY_SIZE=150mb

# TaskList integration
# TASKLIST_AUTH_URL/TASKLIST_AUTH_URLS already exist in current deployments;
# WORKFLOW URL can be left empty and is derived from TASKLIST_AUTH_URL.
TASKLIST_AUTH_URL=
TASKLIST_AUTH_URLS=
TASKLIST_WORKFLOW_API_URL=
TASKLIST_WORKFLOW_API_TOKEN=
TASKLIST_WORKFLOW_READ_METHOD=GET
TASKLIST_WORKFLOW_WRITE_METHOD=PUT
TASKLIST_API_TIMEOUT_SEC=5
TASKLIST_AUTH_TIMEOUT_SEC=1.5
TASKLIST_VERIFY_SSL=false
TASKLIST_ALLOWED_ORIGINS=https://103.77.167.69:8081,http://103.77.167.69:8081,http://14.241.197.188:7749,https://14.241.197.188:7749,http://14.241.197.188,https://14.241.197.188,http://localhost:7749,http://127.0.0.1:7749,http://localhost:3011,http://127.0.0.1:3011
NEXT_PUBLIC_TASKLIST_ALLOWED_ORIGINS=https://103.77.167.69:8081,http://103.77.167.69:8081,http://14.241.197.188:7749,https://14.241.197.188:7749,http://14.241.197.188,https://14.241.197.188,http://localhost:7749,http://127.0.0.1:7749,http://localhost:3011,http://127.0.0.1:3011

# Procurement integration
PROCUREMENT_WEB_URL=http://14.241.197.188:7642
NEXT_PUBLIC_PROCUREMENT_WEB_URL=http://14.241.197.188:7642
PROCUREMENT_RECEIVE_JOB_URL=http://14.241.197.188:7642/api/receive-job
PROCUREMENT_RECEIVE_JOB_METHOD=POST
PROCUREMENT_API_TIMEOUT_SEC=5
PROCUREMENT_DEFAULT_EMPLOYEE_ID=EZE0052
NEXT_PUBLIC_PROCUREMENT_DEFAULT_EMPLOYEE_ID=EZE0052
SSO_DEFAULT_EMPLOYEE_ID=EZE0090
NEXT_PUBLIC_SSO_DEFAULT_EMPLOYEE_ID=EZE0090
DEFAULT_OFFICE_CODE=EZE0098
NEXT_PUBLIC_DEFAULT_OFFICE_CODE=EZE0098

# Local application database
DB_TYPE=sqlite
SQLITE_PATH=storage/ezefloor.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ezefloor

# MSSQL
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DB=emsflow
PROCUREMENT_DB=ProcurementApp
MSSQL_LOGIN_TIMEOUT_SEC=10
MSSQL_QUERY_TIMEOUT_SEC=30

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SEC=180
OPENAI_MAX_RETRIES=3
OPENAI_REASONING_EFFORT=none

# Gemini (optional; key may remain empty when Gemini is disabled)
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# SMTP / notifications (leave credentials empty when mail is not configured)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=EzeFloor AI Support
ADMIN_NOTIFICATION_EMAIL=

# Security / session
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_MAX_AGE=1800
PASSWORD_SALT=
MAX_FAILED_ATTEMPTS=5
TOOL_AI_SSO_SECRET=

# OCR runtime
FLAGS_ENABLE_PIR_API=0
FLAGS_ENABLE_PIR_IN_EXECUTOR=0
FLAGS_PIR_APPLY_INPLACE_PASS=0
FLAGS_USE_MKLDNN=0
KMP_DUPLICATE_LIB_OK=TRUE
