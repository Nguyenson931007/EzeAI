# ============================================================
# EzeFloor - Root .gitignore
# ============================================================


# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

# Local credentials / secrets
*.pem
*.key
*.p12
*.pfx


# ------------------------------------------------------------
# OS / Editor
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

.vscode/
.idea/

*.swp
*.swo
*~
.history/


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python virtual environments
.venv/
venv/
env/
backend/.venv/
backend/venv/


# ------------------------------------------------------------
# Node / Next.js
# ------------------------------------------------------------
node_modules/
**/node_modules/

frontend_next/.next/
.next/

frontend_next/out/
out/

frontend_next/dist/
dist/

frontend_next/build/
build/

*.tsbuildinfo
next-env.d.ts


# ------------------------------------------------------------
# AI / ML models
# ------------------------------------------------------------
# Model weights are kept locally, not in normal Git
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite

# Ultralytics / training caches
*.pt.cache
*.pth.cache

# Training runs / generated datasets
backend/runs/
runs/

backend/dataset/
backend/datasets/
backend/dataset_6class/
backend/dataset_walls/

datasets/wall_prior/

# Training / inference generated outputs
backend/exports/
backend/scratch/
backend/Tesst/

debug_outputs/
label_exports/


# ------------------------------------------------------------
# Local databases
# ------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

backend/storage/*.db
backend/storage/*.sqlite
backend/storage/*.sqlite3


# ------------------------------------------------------------
# Runtime / Cache / Temporary
# ------------------------------------------------------------
cache/
.cache/
temp/
tmp/
logs/

backend/cache/
backend/temp/
backend/logs/

*.log
*.tmp
*.temp

cookies.txt


# ------------------------------------------------------------
# Generated / uploaded files
# ------------------------------------------------------------
uploads/
backend/uploads/

exports/
output/
outputs/

archive/
.archive_cleanup/


# ------------------------------------------------------------
# Large archives / local packages
# ------------------------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Keep source archives only if intentionally force-added
backend.zip


# ------------------------------------------------------------
# Spreadsheet temporary / local reference files
# ------------------------------------------------------------
~$*.xlsx
~$*.xls
~$*.xlsm

*.xlsm


# ------------------------------------------------------------
# Misc generated assets
# ------------------------------------------------------------
image-removebg-preview.png


# ------------------------------------------------------------
# Test generated artifacts
# ------------------------------------------------------------
.coverage
coverage/
test-results/
playwright-report/
# Runtime AI weights live under /models locally; keep folder structure in Git.
models/**/*.pt
models/**/*.onnx
models/**/*.engine
